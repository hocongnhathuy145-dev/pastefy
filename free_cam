local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- --- CẤU HÌNH ---
local MOVE_SPEED = 40    -- Tốc độ di chuyển camera
local ROTATE_SPEED = 0.4  -- Tốc độ xoay camera
local ZOOM_SPEED = 50     -- Tốc độ phóng to / thu nhỏ (FOV)
local MIN_FOV = 15        -- Zoom gần tối đa (Góc nhìn hẹp)
local MAX_FOV = 110       -- Zoom xa tối đa (Góc nhìn rộng)

local isEnabled = false
local cameraPos = Vector3.new(0, 15, 0)
local cameraRot = Vector2.new(0, 0)
local snapBackConfig = nil
local moveVector = Vector3.new(0, 0, 0)

-- --- TẠO GIAO DIỆN MOBILE (GUI) ---
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FreeCamMobileGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = localPlayer:WaitForChild("PlayerGui")

-- Nút Bật/Tắt chính
local ToggleButton = Instance.new("TextButton")
ToggleButton.Name = "ToggleButton"
ToggleButton.Size = UDim2.new(0, 120, 0, 45)
ToggleButton.Position = UDim2.new(0.5, -60, 0, 20)
ToggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
ToggleButton.Text = "Free Cam: OFF"
ToggleButton.TextColor3 = Color3.fromRGB(255, 60, 60)
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.TextSize = 16
ToggleButton.BorderSizePixel = 0
ToggleButton.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = ToggleButton

-- Vùng cảm ứng Di Chuyển (Bên Trái)
local MoveZone = Instance.new("Frame")
MoveZone.Name = "MoveZone"
MoveZone.Size = UDim2.new(0.4, 0, 0.7, 0)
MoveZone.Position = UDim2.new(0, 0, 0.3, 0)
MoveZone.BackgroundTransparency = 1
MoveZone.Visible = false
MoveZone.Parent = ScreenGui

-- Vùng cảm ứng Xoay Camera (Bên Phải)
local LookZone = Instance.new("Frame")
